{
  "ci": {
    "collect": {
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 1638.4,
          "uploadThroughputKbps": 750
        },
        "skipAudits": [
          "uses-http2",
          "canonical"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":    ["error", { "minScore": 0.65, "aggregationMethod": "median" }],
        "categories:accessibility":  ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:best-practices": ["error", { "minScore": 0.90, "aggregationMethod": "median" }],
        "categories:seo":            ["error", { "minScore": 0.95, "aggregationMethod": "median" }],

        "render-blocking-resources":  ["error", { "maxNumericValue":    0, "aggregationMethod": "median" }],
        "modern-image-formats":       ["error", { "maxNumericValue": 5000, "aggregationMethod": "median" }],
        "uses-text-compression":      ["error", { "maxNumericValue":    0, "aggregationMethod": "median" }],
        "efficient-animated-content": ["error", { "maxNumericValue":    0, "aggregationMethod": "median" }],
        "uses-optimized-images":      ["error", { "maxNumericValue": 5000, "aggregationMethod": "median" }],
        "duplicated-javascript":      ["error", { "maxNumericValue":    0, "aggregationMethod": "median" }],
        "legacy-javascript":          ["error", { "maxNumericValue":    0, "aggregationMethod": "median" }],

        "first-contentful-paint":     ["error", { "maxNumericValue": 5500, "aggregationMethod": "median" }],
        "largest-contentful-paint":   ["error", { "maxNumericValue": 7000, "aggregationMethod": "median" }],
        "total-blocking-time":        ["error", { "maxNumericValue":  400, "aggregationMethod": "median" }],
        "cumulative-layout-shift":    ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
        "speed-index":                ["error", { "maxNumericValue": 5500, "aggregationMethod": "median" }],

        "uses-responsive-images":     ["warn",  { "maxNumericValue": 200000, "aggregationMethod": "median" }],
        "unused-css-rules":           ["warn",  { "maxNumericValue":   5000, "aggregationMethod": "median" }],
        "unused-javascript":          ["warn",  { "maxNumericValue":   5000, "aggregationMethod": "median" }]
      }
    }
  }
}
