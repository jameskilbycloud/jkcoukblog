# Cloudflare Pages Headers Configuration
# https://developers.cloudflare.com/pages/configuration/headers/

# Serve Brotli compressed files when available
/*.html
  Content-Encoding: br
/*.css
  Content-Encoding: br
/*.js
  Content-Encoding: br
/*.json
  Content-Encoding: br
/*.xml
  Content-Encoding: br
/*.svg
  Content-Encoding: br

# Security headers (all pages) — must come BEFORE asset-prefix rules so
# their `! Header-Name` lines can strip these off non-document responses.
# Rules apply in file order; a `/*` block placed later would overwrite
# what the asset rules removed.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' plausible.jameskilby.cloud utteranc.es static.cloudflareinsights.com cdn.credly.com cdn.youracclaim.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' plausible.jameskilby.cloud cloudflareinsights.com; frame-src https://www.youtube.com https://player.vimeo.com https://embed.acast.com https://utteranc.es https://plausible.jameskilby.cloud https://www.credly.com https://www.youracclaim.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Static assets — long cache + strip HTML-only headers (CSP /
# X-Frame-Options / Permissions-Policy) that don't govern non-HTML
# responses. Folded into per-prefix blocks because Cloudflare Pages does
# not honour a second block with the same path pattern.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

/wp-content/cache/*
  Cache-Control: public, max-age=31536000, immutable
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

/wp-content/themes/*/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

# Plausible proxy + search JS live at /js/* — add a strip block.
/js/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

# API endpoints, markdown source files, feed, sitemap — strip HTML-only headers
/api/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

/markdown/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

/feed/index.xml
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

/sitemap.xml
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Permissions-Policy

# Cache HTML pages for 5 minutes (allows quick updates)
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Cache JSON files for 5 minutes
/*.json
  Cache-Control: public, max-age=300, must-revalidate
